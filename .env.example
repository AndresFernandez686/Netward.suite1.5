# ─────────────────────────────────────────────
# Netward Suite - Variables de entorno
# Copia este archivo como .env y ajusta los valores
# ─────────────────────────────────────────────

# Seguridad — cambia esto por una clave larga y aleatoria en produccion
SECRET_KEY=cambia-esta-clave-secreta-en-produccion

# Entorno: "production" deshabilita el modo debug
FLASK_ENV=production

# Instancia dedicada por empresa. Usa C001 en cada base aislada para que el
# identificador interno sea opaco e idéntico y no permita relacionar empresas.
TENANT_ISOLATION_MODE=false
ISOLATED_TENANT_ID=C001

# Una base aislada por empresa. Administrador y empleado comparten este origen.
DATABASE_URL=sqlite:///netward_empleado.db

# PostgreSQL en produccion (una URL por instancia/empresa)
# DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/netward

# Nexa, analista de auditoría con IA (la clave nunca se envía al navegador)
AI_ENABLED=false
# openai | openai_compatible | nvidia | anthropic | gemini | custom
# Gemini: AI_PROVIDER=gemini, AI_MODEL=gemini-3.6-flash y deja AI_BASE_URL vacio.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
# Vacío usa la URL oficial del proveedor. Para custom, indica el webhook completo.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
# NVIDIA/Kimi: low | high | max. Se ignora en los demás adaptadores.
AI_REASONING_EFFORT=
AI_SEED=0
# Solo para custom; ejemplo: {"X-API-Key":"clave"}
AI_CUSTOM_HEADERS_JSON={}
# Modo temporal: usa el bot local de Nexa sin consultar OpenAI.
AI_LOCAL_FALLBACK_ENABLED=true

# Azure AI Document Intelligence para analizar facturas PDF.
# En modo aislado, cada despliegue debe usar un recurso y una clave diferentes.
 AI_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_SECONDS=60
AZURE_DOCUMENT_INTELLIGENCE_POLL_SECONDS=1

# OCR de facturas PDF escaneadas (opcional si tesseract no está en PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Servidor (solo aplica cuando se corre con app.py directo)
HOST=0.0.0.0
PORT=5000

# Version de assets estaticos (se auto-genera si se deja vacio)
# ASSET_VERSION=20260101000000
